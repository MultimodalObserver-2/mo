SONAR_TOKEN=your_sonar_token
VITE_DEV_API_PORT=your_api_port # Default: 8000
VITE_REPOSITORY_API_HOST=your_repository_host # Default: localhost:8001 in dev, mo.diinf.usach.cl in prod. Host only: the app adds the scheme and /api/v1
VITE_REPOSITORY_WEB_HOST=your_repository_web_host # Default: localhost:3000 in dev, mo.diinf.usach.cl in prod. Host only
